{
  "name": "agent-matrix",
  "productName": "AgentMatrix",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop workspace for your agents, MCP servers, skills and plugins.",
  "author": "AgentMatrix",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:sessions": "npm run build && node --experimental-strip-types scripts/session-smoke.mjs",
    "test:shared-assets": "npm run build && node --experimental-strip-types scripts/shared-assets-smoke.mjs",
    "test:native-import": "npm run build && node --experimental-strip-types scripts/native-import-smoke.mjs",
    "test:credential-rotation": "npm run build && node --experimental-strip-types scripts/credential-rotation-smoke.mjs",
    "probe:engines": "node scripts/probe-engines.mjs",
    "probe:acp": "vitest run --config vitest.acp.config.ts",
    "probe:opencode": "vitest run --config vitest.opencode.config.ts",
    "probe:pi": "vitest run --config vitest.pi.config.ts",
    "probe:dsh": "vitest run --config vitest.dsh.config.ts",
    "probe:providers": "vitest run --config vitest.providers.config.ts --maxWorkers=1",
    "probe:isolation": "vitest run --config vitest.isolation.config.ts --maxWorkers=1",
    "check": "npm run lint && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:ipc-errors": "npm run build && node --experimental-strip-types scripts/ipc-errors-smoke.mjs",
    "probe:skills": "vitest run --config vitest.skills.config.ts --maxWorkers=1",
    "test:foundation": "npm run build && node scripts/smoke.mjs --foundation"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@babel/parser": "7.29.8",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glob": "13.0.5",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^0.577.0",
    "minimatch": "10.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "7.8.5",
    "tailwind-merge": "^3.7.0",
    "yaml": "2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "playwright": "^1.58.0",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.0",
    "vitest": "4.1.11"
  }
}
